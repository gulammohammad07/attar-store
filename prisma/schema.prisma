generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  imageUrl    String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  price       Float
  description String?
  imageUrl    String
  imagePublicId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bestSeller  Boolean  @default(false)
  brandId     String
  categoryId  String
  featured    Boolean  @default(false)
  gallery     String[]
  isActive    Boolean  @default(true)
  newArrival  Boolean  @default(false)
  salePrice   Float?
  sku         String?  @unique
  stock       Int      @default(0)
  volume      String
  notes       String[] @default([])
  brand       Brand    @relation(fields: [brandId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])
}
