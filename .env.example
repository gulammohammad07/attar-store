# Razorpay (server-only; never prefix the secret with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Existing Cloudinary configuration required for product media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP mail server used for order notifications & password reset (server-only).
# Recommended for Vercel + Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=yourname@gmail.com
#   SMTP_PASS=16characterapppassword (from https://myaccount.google.com/apppasswords)
#   SMTP_FROM_EMAIL=yourname@gmail.com
#   SMTP_FROM_NAME=Danish Perfumes
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Danish Perfumes

# WhatsApp order notifications via CallMeBot (free, personal use).
# Setup: save +34 684 783 708 in contacts, WhatsApp it
# "I allow callmebot to send me messages", and it replies with your API key.
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
