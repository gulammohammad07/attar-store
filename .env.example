# Razorpay (server-only; never prefix the secret with NEXT_PUBLIC_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Existing Cloudinary configuration required for product media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP mail server used for order notifications (server-only).
# New orders are emailed to the store's support email (Admin → Settings),
# so no extra recipient variable is needed.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
